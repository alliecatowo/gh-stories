# --- local configuration & credentials -------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- build output ----------------------------------------------------------
# The root executable that `gh extension install .` runs. Generated by
# `mise run build`; release distribution uses the published binaries instead.
# NOTE: gitignore has no trailing comments — a comment after a pattern becomes
# part of the pattern, which is how this file silently tracked the binary.
/gh-stories
/gh-stories.exe
/dist/
/bin/
**/.output/
**/.wxt/
**/dist/
**/node_modules/
apps/site/.astro/

# --- Go --------------------------------------------------------------------
*.test
*.out
coverage.*

# --- test & capture artifacts ----------------------------------------------
/evidence/raw/
/test-results/
/playwright-report/
/blob-report/
**/.playwright/
tests/e2e/.auth/
*.log

# --- OS / editor -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
