# GitHub Stories — copy to .env for local development.
# Required variables are validated at startup; missing names are reported
# without printing their values.  Never commit a real .env.

# ---------------------------------------------------------------- environment
# local | test | production.  Production refuses to start with any test
# identity provider, seeded account, or controllable clock enabled.
GHS_ENV=local

# --------------------------------------------------------------------- service
GHS_HTTP_ADDR=:8787
# Public base URL of the service. Used to build OAuth callbacks, CLI
# authorization URLs and external viewer links.
GHS_PUBLIC_URL=http://localhost:8787
# Comma-separated exact origins allowed to call the API with credentials.
# Includes the extension origins in production.
GHS_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:4321

# -------------------------------------------------------------------- database
GHS_DATABASE_URL=postgres://stories:stories_local_dev@localhost:55432/stories?sslmode=disable

# ------------------------------------------------------- private object storage
GHS_S3_ENDPOINT=http://localhost:55900
GHS_S3_REGION=us-east-1
GHS_S3_BUCKET=stories-media
GHS_S3_ACCESS_KEY_ID=storiesminio
GHS_S3_SECRET_ACCESS_KEY=storiesminio_local_dev
GHS_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------- GitHub OAuth
# Register at https://github.com/settings/developers with callback
#   $GHS_PUBLIC_URL/v1/auth/github/callback
GHS_GITHUB_CLIENT_ID=
GHS_GITHUB_CLIENT_SECRET=

# --------------------------------------------------------------------- secrets
# 32+ byte random string used to derive session/token hashing keys.
# Generate with:  openssl rand -base64 48
GHS_SECRET_KEY=change-me-local-development-only-0123456789abcdef

# ----------------------------------------------------------------- moderation
# Comma-separated GitHub NUMERIC user ids granted moderator access. Numeric
# because logins are renameable. Applied at startup: anyone removed from this
# list is demoted on the next restart. There is deliberately no way to become a
# moderator from inside the product.
#   Find an id with: curl -s https://api.github.com/users/USERNAME | jq .id
GHS_MODERATOR_GITHUB_IDS=

# --------------------------------------------------------------------- limits
GHS_MAX_UPLOAD_BYTES=104857600
GHS_MAX_VIDEO_SECONDS=60
GHS_MAX_IMAGE_PIXELS=50000000

# ---------------------------------------------------------------- local only
# Test identity provider replaces ONLY the external GitHub identity boundary.
# Startup fails if this is true while GHS_ENV=production.
GHS_TEST_IDENTITY_PROVIDER=false
# Controllable clock for deterministic expiry tests. Production refuses it.
GHS_TEST_CLOCK=false
