{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "types": ["chrome", "vitest/globals"]
  },
  "include": ["entrypoints/**/*", "src/**/*", "tests/**/*", "wxt.config.ts"],
  "exclude": ["node_modules", ".output", ".wxt/**/*.js"]
}
