---
import { withBase } from '../lib/base';
---

<!--
  Hero juxtaposition: a real capture of the extension's Story viewer open over
  a pull request, beside a real capture of `gh stories` rendering the same kind
  of media inline in kitty.

  Both images are genuine captures produced by the visual suites, not mockups:
    - /media/browser-pr-story.png  — Chromium with the MV3 extension loaded,
      driving a github.com URL whose content is a fictional fixture.
    - /media/terminal-story.png    — kitty on a real X display, captured from
      the display's framebuffer.
  Regenerate both with `mise run capture`.
-->
<a class="hero-demo" href={withBase('/demo/')}>
  <span class="ghs-visually-hidden">
    Open the interactive sample demo. Preview: the Story viewer open over a pull request in a
    browser, beside a terminal rendering the same photo inline.
  </span>
  <div class="hero-demo__label" aria-hidden="true">
    <span>Real captures. Sample accounts and photos.</span>
    <span class="hero-demo__cta">Open the interactive demo →</span>
  </div>

  <div class="hero-demo__panels">
    <figure class="hero-demo__panel">
      <img
        src={withBase('/media/browser-pr-story.png')}
        alt="A GitHub pull request with a Story ring on an avatar, and the Story viewer open over it playing a photo."
        width="1100"
        height="773"
        loading="eager"
        decoding="async"
      />
      <figcaption>The extension, on a pull request</figcaption>
    </figure>

    <figure class="hero-demo__panel">
      <img
        src={withBase('/media/terminal-story.png')}
        alt="A terminal window showing gh stories rendering a photo inline, with progress segments and a caption."
        width="1100"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <figcaption><code>gh stories</code>, in kitty</figcaption>
    </figure>
  </div>
</a>

<style>
  .hero-demo {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--ghs-border);
    border-radius: var(--ghs-radius-lg);
    background: var(--ghs-canvas-subtle);
    padding: var(--ghs-space-3);
    transition: border-color 0.16s ease;
  }
  .hero-demo:hover {
    border-color: var(--ghs-accent);
  }
  .hero-demo:focus-visible {
    outline: 2px solid var(--ghs-accent);
    outline-offset: 3px;
  }
  .hero-demo__label {
    display: flex;
    justify-content: space-between;
    gap: var(--ghs-space-3);
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--ghs-fg-muted);
    margin-bottom: var(--ghs-space-3);
  }
  .hero-demo__cta {
    color: var(--ghs-accent);
    font-weight: 500;
  }
  .hero-demo__panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ghs-space-3);
  }
  @media (max-width: 720px) {
    .hero-demo__panels {
      grid-template-columns: 1fr;
    }
  }
  .hero-demo__panel {
    margin: 0;
    min-width: 0;
  }
  .hero-demo__panel img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--ghs-radius-md);
    border: 1px solid var(--ghs-border);
    background: #0d1117;
  }
  .hero-demo__panel figcaption {
    margin-top: var(--ghs-space-2);
    font-size: 0.8125rem;
    color: var(--ghs-fg-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-demo {
      transition: none;
    }
  }
</style>
