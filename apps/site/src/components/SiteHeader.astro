---
import { withBase } from '../lib/base';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const links = [
  { href: '/demo/', label: 'Demo' },
  { href: '/docs/install/', label: 'Install' },
  { href: '/docs/support/', label: 'Support' },
  { href: '/docs/privacy/', label: 'Privacy' },
  { href: '/docs/self-hosting/', label: 'Self-hosting' },
];
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
    <a class="flex items-center gap-2.5 font-semibold text-foreground no-underline" href={withBase('/')}>
      <span class="story-ring" style="padding:2px"><span class="block size-5 rounded-full bg-background"></span></span>
      <span class="text-[1.05rem] tracking-tight">GitHub Stories</span>
    </a>
    <nav class="order-3 flex w-full justify-center gap-1 text-sm sm:order-none sm:w-auto" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class:list={[
              'rounded-full px-3 py-1.5 no-underline transition-colors hover:bg-accent hover:text-foreground',
              currentPath === link.href ? 'bg-accent text-foreground' : 'text-muted-foreground',
            ]}
            href={withBase(link.href)}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
