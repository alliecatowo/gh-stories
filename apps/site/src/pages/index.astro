---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.tsx';
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import { cardClass } from '../components/ui/card';
import { cn } from '../lib/utils';
import { withBase } from '../lib/base';
import { VISIBILITY_LABELS, VISIBILITY_DESCRIPTIONS, STORY_LIFETIME_MS } from '@gh-stories/contracts';

const REPO = 'https://github.com/alliecatowo/gh-stories';
const DL = `${REPO}/releases/latest/download`;
const lifetimeHours = STORY_LIFETIME_MS / (60 * 60 * 1000);
const audiences = Object.keys(VISIBILITY_LABELS) as (keyof typeof VISIBILITY_LABELS)[];
const eyebrow = 'font-mono text-xs font-medium uppercase tracking-[0.14em] text-primary';
const h2 = 'mt-3 text-3xl font-bold leading-tight sm:text-4xl';
---

<BaseLayout
  title="GitHub Stories"
  description="Stories for GitHub. Yes, those Stories. Photos, videos, selfies, concerts, cats, food, memes, shitposts, on avatars you already know and in your terminal. Expires after 24 hours."
  path="/"
>
  <section class="wrap grid items-center gap-12 pb-12 pt-12 lg:grid-cols-[1.1fr_0.9fr] lg:pb-20 lg:pt-20">
    <div>
      <Badge variant="outline">Independent project · not affiliated with GitHub</Badge>
      <h1 class="m-0 mt-6 text-5xl font-extrabold leading-[0.98] tracking-tight sm:text-7xl">GitHub Stories</h1>
      <p class="m-0 mt-5 text-2xl font-semibold leading-snug text-primary sm:text-3xl">Stories for GitHub. Yes, those Stories.</p>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-muted-foreground">
        Photos, videos, selfies, concerts, cats, food, memes, shitposts. They expire after {lifetimeHours} hours.
        They appear as a ring on avatars you already know, and in your terminal.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class={buttonVariants({ size: 'lg' })} href="#install">Get the extension</a>
        <a class={buttonVariants({ size: 'lg', variant: 'outline' })} href={withBase('/demo/')}>Try the demo</a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">The demo runs in your browser with fictional sample content. No login.</p>
    </div>

    <figure class="mx-auto w-full max-w-[340px] lg:max-w-[380px]">
      <div class="relative">
        <div class="story-ring absolute inset-[-10px] opacity-90" style="padding:6px;border-radius:2.25rem" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] border-4 border-background bg-terminal">
          <img
            src={withBase('/media/extension-viewer.webp')}
            alt="The Story viewer open over a pull request: a concert photo with a reply box and emoji reactions."
            width="1280" height="900" class="aspect-[3/4] h-auto w-full object-cover object-center" fetchpriority="high"
          />
        </div>
      </div>
      <figcaption class="mt-6 text-center text-xs text-muted-foreground">Real extension capture. Fictional account, sample photo.</figcaption>
    </figure>
  </section>

  <nav class="wrap pb-6" aria-label="On this page">
    <div class="story-bars">
      <a href="#rings">Rings</a><a href="#post">Post</a><a href="#terminal">Terminal</a><a href="#privacy">Privacy</a><a href="#install">Install</a>
    </div>
  </nav>

  <section id="rings" class="wrap scroll-mt-24 py-16 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class={eyebrow}>01 / Rings</p>
        <h2 class={h2}>The ring you already recognise, on the avatars you already know.</h2>
        <p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-muted-foreground">
          The extension puts a pink-to-purple ring around avatars on pull requests, issues and profiles when that person has a Story you can see. Click it and the Story opens over the page. Close it and your code review is exactly where you left it.
        </p>
        <p class="mt-4 max-w-[52ch] leading-relaxed text-muted-foreground">
          It never writes to github.com and never touches who you follow there. Follows on Stories are separate.
        </p>
      </div>
      <div class="flex items-center justify-center gap-6 rounded-3xl border border-border bg-muted/60 p-10" role="img" aria-label="Ring states: unseen, seen, muted">
        {[['unseen', 'conic'], ['seen', 'seen'], ['muted', 'muted']].map(([label, kind]) => (
          <div class="flex flex-col items-center gap-3">
            <div class:list={['rounded-full p-1', kind === 'conic' ? 'story-ring' : kind === 'seen' ? 'bg-border' : 'border-2 border-dashed border-muted-foreground bg-transparent']} style="padding:4px">
              <div class="size-16 rounded-full border-[3px] border-background bg-gradient-to-br from-primary/30 to-pink/30 sm:size-20"></div>
            </div>
            <span class="font-mono text-xs text-muted-foreground">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="post" class="wrap scroll-mt-24 py-16 lg:py-24">
    <p class={eyebrow}>02 / Post</p>
    <h2 class={h2}>Drop in a photo. Pick who sees it. It cleans up after itself.</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {[
        ['Compose', 'Drag in a photo or video, crop it, rotate it, add a caption and alt text.'],
        ['Choose', 'Five audiences, picked before you post. There is no default that quietly means everyone.'],
        ['Forget', `Every item expires ${lifetimeHours} hours after it was published. Nothing to clean up later.`],
      ].map(([title, body], i) => (
        <div class={cn(cardClass, 'p-6')}>
          <span class="font-mono text-sm text-primary">0{i + 1}</span>
          <h3 class="mt-2 text-xl font-semibold">{title}</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="terminal" class="wrap scroll-mt-24 py-16 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="order-2 lg:order-1">
        <div class="overflow-hidden rounded-2xl border border-border bg-terminal shadow-lg">
          <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5" aria-hidden="true">
            <i class="size-2.5 rounded-full bg-[#eb6f92]"></i><i class="size-2.5 rounded-full bg-[#c4a7e7]"></i><i class="size-2.5 rounded-full bg-[#9ccfd8]"></i>
            <span class="ml-3 font-mono text-xs text-white/50">gh stories</span>
          </div>
          <img src={withBase('/media/terminal-story.webp')} alt="gh stories showing a Story in a terminal: progress bars, the author, a cat photo rendered inline and keyboard hints." width="1013" height="783" class="h-auto w-full" />
        </div>
        <p class="mt-3 text-xs text-muted-foreground">Real capture of the CLI in a terminal that supports inline images.</p>
      </div>
      <div class="order-1 lg:order-2">
        <p class={eyebrow}>03 / Terminal</p>
        <h2 class={h2}>A picture, in your terminal. Really.</h2>
        <p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-muted-foreground">
          <code class="rounded bg-muted px-1.5 py-0.5 text-[0.9em]">gh stories</code> draws the actual image inline using the Kitty graphics protocol, or iTerm2's inline images. Everywhere else it falls back honestly: it opens the image in your viewer and tells you so.
        </p>
        <p class="mt-4"><a class="font-medium text-primary" href={withBase('/docs/support/')}>See the exact support matrix →</a></p>
      </div>
    </div>
  </section>

  <section id="privacy" class="scroll-mt-24 border-y border-border bg-muted/50 py-16 lg:py-24">
    <div class="wrap">
      <p class={eyebrow}>04 / Privacy</p>
      <h2 class={h2}>Privacy, plainly.</h2>
      <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-muted-foreground">Every Story is published to exactly one audience, chosen before you post.</p>
      <ul class="m-0 mt-8 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-5">
        {audiences.map((key) => (
          <li class={cn(cardClass, 'p-4')}>
            <p class="font-semibold">{VISIBILITY_LABELS[key]}</p>
            <p class="mt-1 text-sm leading-snug text-muted-foreground">{VISIBILITY_DESCRIPTIONS[key]}</p>
          </li>
        ))}
      </ul>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class={cn(cardClass, 'p-6')}>
          <h3 class="text-lg font-semibold">{lifetimeHours} hours, per item</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">Each item expires {lifetimeHours} hours after it was published, not after your last post. Nothing can be pinned past that.</p>
        </div>
        <div class={cn(cardClass, 'p-6')}>
          <h3 class="text-lg font-semibold">No long-lived links</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">Private media is streamed through an authorization gateway, so a block or a deletion takes effect immediately.</p>
        </div>
        <div class={cn(cardClass, 'p-6')}>
          <h3 class="text-lg font-semibold">What the extension sends</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">On github.com it looks up which visible accounts have a Story, using the avatar ids and logins it sees. Nothing is written to GitHub.</p>
        </div>
      </div>
      <p class="mt-8 max-w-[70ch] text-sm leading-relaxed text-muted-foreground">
        None of this un-sends a photo someone already saw. Deleting a Story stops future access; it cannot reach back onto another person's screen.
        <a class="ml-1 font-medium text-primary" href={withBase('/docs/privacy/')}>Full privacy and retention page →</a>
      </p>
    </div>
  </section>

  <section id="install" class="wrap scroll-mt-24 py-16 lg:py-24">
    <p class={eyebrow}>05 / Install</p>
    <h2 class={h2}>Two clients, one account.</h2>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <div class={cn(cardClass, 'flex min-w-0 flex-col gap-3 p-6')}>
        <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Chrome &amp; Edge</h3><Badge variant="soon">store: coming soon</Badge></div>
        <p class="text-sm leading-relaxed text-muted-foreground">Not in the Chrome Web Store yet. Manual install from the release archive takes about a minute.</p>
        <div class="mt-auto flex flex-wrap gap-2 pt-2">
          <a class={buttonVariants({ size: 'sm' })} href={`${DL}/gh-stories-extension-chrome.zip`}>Download for Chrome</a>
          <a class={buttonVariants({ size: 'sm', variant: 'outline' })} href={`${DL}/gh-stories-extension-edge.zip`}>Edge</a>
        </div>
      </div>
      <div class={cn(cardClass, 'flex min-w-0 flex-col gap-3 p-6')}>
        <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Firefox</h3><Badge variant="soon">add-on: coming soon</Badge></div>
        <p class="text-sm leading-relaxed text-muted-foreground">There is no signed Firefox add-on yet. Load the release archive as a temporary add-on.</p>
        <div class="mt-auto flex flex-wrap gap-2 pt-2">
          <a class={buttonVariants({ size: 'sm' })} href={`${DL}/gh-stories-extension-firefox.zip`}>Download for Firefox</a>
        </div>
      </div>
      <div class={cn(cardClass, 'flex min-w-0 flex-col gap-3 p-6')}>
        <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Terminal</h3><Badge>gh extension</Badge></div>
        <CopyCommand client:visible label="gh stories" lines={['gh extension install alliecatowo/gh-stories', 'gh stories setup', 'gh stories login', 'gh stories']} />
      </div>
    </div>
    <p class="mt-6 text-sm text-muted-foreground">
      Step-by-step instructions for each browser are on the <a class="font-medium text-primary" href={withBase('/docs/install/')}>install page</a>. Source and releases are on <a class="font-medium text-primary" href={REPO}>GitHub</a>.
    </p>
  </section>
</BaseLayout>
